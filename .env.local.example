# Copy the needed values into your production server's Environment Variables.

# Public application origin. Must be the final HTTPS domain in production.
NEXT_PUBLIC_APP_URL=https://your-domain.com

# OpenAI — currently unused by the app, kept for future fallback support.
OPENAI_API_KEY=sk-...

# Google Gemini — set this for live AI feedback; without it the app returns sample feedback.
GEMINI_API_KEY=

# Clerk — set both keys to enable production sign-in and protected API routes.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Database — optional in local demo mode; required for saving score history.
# Use the full connection string from your PostgreSQL provider.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/ielts-up?sslmode=require

# Optional monitoring. When true, browser Web Vitals are posted to /api/monitoring/web-vitals.
NEXT_PUBLIC_ENABLE_WEB_VITALS=false
